  m_Script: {fileID: 11500000, guid: 83d0b0481880beb49bd60646c38a5d1b, type: 3}
  m_Name: Warning
  m_EditorClassIdentifier: Assembly-CSharp::DialogNode
  speakerName: "L\u01B0u \xFD"
  text: "Tr\xF2 ch\u01A1i n\xE0y l\xE0 m\u1ED9t t\xE1c ph\u1EA9m h\u01B0 c\u1EA5u.
    M\u1ECDi nh\xE2n v\u1EADt, \u0111\u1ECBa danh, t\u1ED5 ch\u1EE9c, s\u1EF1 ki\u1EC7n
    v\xE0 t\xECnh ti\u1EBFt xu\u1EA5t hi\u1EC7n trong tr\xF2 ch\u01A1i \u0111\u1EC1u
    l\xE0 s\u1EA3n ph\u1EA9m c\u1EE7a tr\xED t\u01B0\u1EDFng t\u01B0\u1EE3ng c\u1EE7a
    \u0111\u1ED9i ng\u0169 ph\xE1t tri\u1EC3n v\xE0 kh\xF4ng d\u1EF1a tr\xEAn b\u1EA5t
    k\u1EF3 c\xE1 nh\xE2n, t\u1ED5 ch\u1EE9c hay s\u1EF1 ki\u1EC7n c\xF3 th\u1EADt
    n\xE0o.\n\nM\u1ECDi s\u1EF1 tr\xF9ng h\u1EE3p v\u1EDBi ng\u01B0\u1EDDi th\u1EADt,
    \u0111\u1ECBa \u0111i\u1EC3m c\xF3 th\u1EADt ho\u1EB7c c\xE1c s\u1EF1 ki\u1EC7n
    ngo\xE0i \u0111\u1EDDi th\u1EF1c (n\u1EBFu c\xF3) \u0111\u1EC1u ho\xE0n to\xE0n
    l\xE0 ng\u1EABu nhi\xEAn v\xE0 kh\xF4ng mang b\u1EA5t k\u1EF3 ch\u1EE7 \xFD n\xE0o."
  choices: []
